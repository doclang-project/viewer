{
  "name": "DocLang Viewer",
  "short_name": "DocLang",
  "description": "Viewer for DocLang archives (.dclx) and markup (.dclg, .xml).",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "icons": [
    { "src": "assets/favicon-16x16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "assets/favicon-32x32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-1024.png", "sizes": "1024x1024", "type": "image/png" },
    { "src": "assets/doclang_v3_sail.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./?source=file-handler",
      "accept": {
        "application/x-dclx": [".dclx"],
        "application/x-dclg": [".dclg"]
      }
    }
  ]
}
